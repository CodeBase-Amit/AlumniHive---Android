<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic to the Android emulator host IP used for localhost (10.0.2.2) -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- IP literals are supported here; do not include subdomains for an IP -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
    <!-- Keep default restrictions for other hosts -->
</network-security-config>

